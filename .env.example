# Do not commit .env. Create secrets with: openssl rand -hex 32
SKYHUB_VIEW_TOKEN=REPLACE_WITH_RANDOM_TOKEN
SKYHUB_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SKYHUB_MINIO_USER=skyhub_next_admin
SKYHUB_MINIO_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Legacy default: EMQX/1884. No broker is started by SkyHub Next.
# Mosquitto requires coordinated EXPLICIT changes on the private Pi .env:
# SKYHUB_MQTT_BROKER_KIND=mosquitto, SKYHUB_MQTT_REQUIRED_PORT=1883,
# MQTT_BROKER_URL=mqtt://host.docker.internal:1883 and RC-reachable Pilot MQTT :1883.
# Do not switch before broker ACL, Docker-host reachability and Pilot 2 checks.
SKYHUB_MQTT_BROKER_KIND=emqx
SKYHUB_MQTT_REQUIRED_PORT=1884
MQTT_BROKER_URL=mqtt://host.docker.internal:1884
MQTT_USER=REPLACE_WITH_BROKER_USERNAME
MQTT_PASSWORD=REPLACE_WITH_BROKER_PASSWORD
SKYHUB_BIND_ADDRESS=127.0.0.1
SKYHUB_HTTP_PORT=4001

# DJI Pilot 2 bootstrap (optional, initially disabled)
# Important: do NOT enable while the backend is published to 0.0.0.0:4000.
# A Caddy HTTPS route to a loopback-only backend is required for live bootstrap.
SKYHUB_PILOT_ENABLED=false
SKYHUB_PILOT_ACCESS_TOKEN=REPLACE_WITH_RANDOM_TOKEN_64_HEX
SKYHUB_DJI_APP_ID=REPLACE_WITH_DJI_CLOUD_APP_ID
SKYHUB_DJI_APP_KEY=REPLACE_WITH_DJI_CLOUD_APP_KEY
SKYHUB_DJI_APP_LICENSE=REPLACE_WITH_DJI_CLOUD_LICENSE
SKYHUB_PILOT_MQTT_URL=mqtt://192.168.178.63:1884
SKYHUB_PILOT_MQTT_USER=REPLACE_WITH_PILOT_USER
SKYHUB_PILOT_MQTT_PASSWORD=REPLACE_WITH_PILOT_PASSWORD
SKYHUB_PILOT_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID

# DJI map-group GET route; OFF until the isolated schema migration and Pilot API module are validated.
SKYHUB_DJI_MAP_ELEMENTS_ENABLED=false

# DJI Pilot 2 situation awareness (TSA): pushes fleet positions/presence to paired RCs over
# wss://<public origin>/ws/tsa and serves GET /manage/api/v1/workspaces/{id}/devices/topologies.
# OFF until Caddy routes /ws/tsa and /manage/api/* (scripts/pi-caddy-pilot-tsa.sh) and a hardware test.
# Pilot 2 puts the device token into the WebSocket URL: the Caddy script removes it from access logs.
SKYHUB_DJI_TSA_ENABLED=false
SKYHUB_PILOT_PUBLIC_URL=https://rpi5.fritz.box

# DJI topology acknowledgements: OFF until ACL and hardware validation.
# Pilot 2 expects status_reply to update_topo; without it no OSD was observed (RC Pro, 2026-10-20).
# Create a separate broker account whose only write ACL is sys/product/+/status_reply.
# Never use SKYHUB_PILOT_MQTT_USER as the server publisher account.
SKYHUB_TOPOLOGY_ACK_ENABLED=false
SKYHUB_TOPOLOGY_ACK_MQTT_USER=
SKYHUB_TOPOLOGY_ACK_MQTT_PASSWORD=

# Token-free, read-only dashboard from one private home network (via Caddy :4443).
# Leave empty to always require SKYHUB_VIEW_TOKEN.
SKYHUB_LAN_VIEW_CIDR=

# false: do not store new flight-track positions or auto-prune history.
# Live OSD, map, topology and existing track reads are unaffected.
SKYHUB_TRACK_RECORDING_ENABLED=false
# Days of track history kept in PostGIS when recording is on (1-3650).
SKYHUB_TRACK_RETENTION_DAYS=30
