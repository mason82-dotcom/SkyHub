{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawMedia",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-media-raw"
      ]
    },
    {
      "Sid": "GetRawMedia",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-media-raw/*"
      ]
    },
    {
      "Sid": "ListDerived",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-media-derived"
      ]
    },
    {
      "Sid": "DerivedObjectIO",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-media-derived/*"
      ]
    }
  ]
}
