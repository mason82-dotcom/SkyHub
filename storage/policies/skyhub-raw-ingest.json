{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRawBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-media-raw"
      ]
    },
    {
      "Sid": "WriteRawObjectsNoDelete",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-media-raw/*"
      ]
    }
  ]
}
