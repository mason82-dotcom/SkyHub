{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProbeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-storage-smoke"
      ]
    },
    {
      "Sid": "WriteReadDeleteProbeOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-storage-smoke/__skyhub_smoke__/*"
      ]
    }
  ]
}
