{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWpml",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-wpml"
      ]
    },
    {
      "Sid": "ReadWpml",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::skyhub-wpml/*"
      ]
    }
  ]
}
