# Bind only to the Raspberry Pi/LAN address that DJI Pilot 2 may reach.
SKYHUB_LAN_IP=192.168.178.63

# Generate independent random values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-32-char-random-hex
REDIS_PASSWORD=replace-with-32-char-random-hex
EMQX_NODE_COOKIE=replace-with-32-char-random-hex
EMQX_DASHBOARD_PASSWORD=replace-with-32-char-random-hex
MQTT_CORE_PASSWORD=replace-with-32-char-random-hex
MQTT_GATEWAY_PASSWORD=replace-with-32-char-random-hex
PILOT_USERNAME=skyhub-pilot
PILOT_PASSWORD=replace-with-32-char-random-hex

# Flight-affecting actions remain off until they receive a separate safety review.
MISSION_DISPATCH_ENABLED=false
SKYHUB_ADMIN_TOKEN=
MISSION_FILE_ALLOWED_ORIGINS=
